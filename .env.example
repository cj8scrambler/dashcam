# Copy to .env and edit. Used by docker-compose.yml.

# REQUIRED. Absolute path on the host to your dashcam data directory - the one
# containing the Normal/ (video) and GPS/ (*.dat) subdirectories. Mounted
# read-only into the container.
DASHCAM_DATA_PATH=/media/you/DASHCAM

# REQUIRED. Where the app stores its logins (users.json) and session secret_key.
# A relative path is allowed but must start with ./ or ../ and is resolved
# against the compose-file directory. Create it and make it writable by uid 1000
# (the container's user):
#     mkdir -p ./config && sudo chown 1000:1000 ./config && chmod 700 ./config
# These are plain files - back them up; `docker compose down -v` won't touch them.
DASHCAM_CONFIG_PATH=./config

# IANA timezone the camera's clock is set to (naive timestamps are localized to
# this zone, then stored as UTC). Use a zone name, not a fixed offset, so DST is
# handled automatically.
DASHCAM_RECORD_TZ=America/Chicago

# Optional. Show times in a different zone than the camera recorded them in.
# Leave blank to display in DASHCAM_RECORD_TZ.
DASHCAM_DISPLAY_TZ=

# Where to publish the viewer. Default is localhost only - intended to sit
# behind nginx on the host, which terminates TLS. Examples:
#   127.0.0.1:5000   only this machine, for a reverse proxy (default)
#   0.0.0.0:5000     any interface - only if you're not using a proxy
DASHCAM_BIND=127.0.0.1:5000

# Refuse to start without a configured login. Leave at 1 unless the viewer is
# already gated some other way.
DASHCAM_REQUIRE_AUTH=1

# Session cookies are marked Secure (HTTPS-only) by default. Set to 0 only if
# you are deliberately serving plain HTTP.
DASHCAM_SECURE_COOKIE=1

# Optional. Provide the session-signing key explicitly instead of letting the
# app generate and store one at <config>/secret_key. Any long random string.
# DASHCAM_SECRET_KEY=

# Transcoder. "none" = software libx264 (default, works anywhere). "nvenc" =
# NVIDIA GPU (CUDA decode + scale + h264_nvenc). For "nvenc" you must also
# uncomment the deploy: and NVIDIA_DRIVER_CAPABILITIES lines in
# docker-compose.yml and have nvidia-container-toolkit on the host. If the GPU
# can't be used the app logs it and falls back to software.
DASHCAM_HWACCEL=none

# Max simultaneous GPU (nvenc) encodes. GeForce cards cap NVENC sessions
# (historically 3); extra requests queue. Ignored for software.
DASHCAM_HWACCEL_CONCURRENCY=3

# Pick up newly-synced footage without restarting the container.
# Seconds between background re-scans of the data dir. 0 disables it; anything
# below 30 is floored to 30. 300 (5 min) is a fine default.
DASHCAM_RESCAN_INTERVAL=300

# File (inside the container) whose mtime the app watches for an immediate
# re-scan. The sftp service's upload dir /home/offload/dashcam is the same host
# dir as the viewer's /data, so the offload daemon touching `dashcam/.reload`
# over SFTP bumps `/data/.reload` here - the app re-scans within ~5s. You can
# also `touch <data dir>/.reload` on the host to force a re-scan manually.
# Set blank to disable.
DASHCAM_RELOAD_TRIGGER=/data/.reload


### --- SFTP drop point (the `sftp` service) --------------------------------- ###

# Interface:port the SFTP server listens on. Use the docker-host's private VLAN
# address so it's only reachable from the offload machine. NEVER 0.0.0.0.
SFTP_BIND=192.168.1.70:2222

# One-time setup before `docker compose up`:
#
#   mkdir -p ./config/sftp/keys
#
#   # SSH host keys (so the offload daemon doesn't see host-key-changed warnings):
#   ssh-keygen -t ed25519 -N '' -f ./config/sftp/ssh_host_ed25519_key
#   ssh-keygen -t rsa -b 4096 -N '' -f ./config/sftp/ssh_host_rsa_key
#
#   # On the offload machine (192.168.1.11): ssh-keygen -t ed25519
#   # then copy its PUBLIC key here:
#   scp offload-host:~/.ssh/id_ed25519.pub ./config/sftp/keys/offload.pub
#
#   sudo chown -R 1000:1000 ./config/sftp
